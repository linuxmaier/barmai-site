# Static site behind the home-server platform's Cloudflare Tunnel. Cloudflare terminates TLS,
# so this listens on plain HTTP and runs with no admin API.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		# Public but unlisted: keep every page out of search results.
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Built assets have hashed names and never change.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"

	# Health check for the platform, not a page.
	respond /healthz 200

	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
