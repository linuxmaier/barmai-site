---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// An entry's image at book-cover proportions, or, until there is one, a typeset stand-in.
interface Props {
  title: string;
  byline?: string;
  image?: ImageMetadata;
  alt?: string;
  sizes: string;
  class?: string;
}

const { title, byline, image, alt, sizes, class: className } = Astro.props;
---

{
  image ? (
    <Image
      class:list={['cover', className]}
      src={image}
      alt={alt ?? `Cover of ${title}`}
      widths={[240, 480, 720]}
      sizes={sizes}
    />
  ) : (
    <div class:list={['cover', 'stand-in', className]} aria-hidden="true">
      <span class="t">{title}</span>
      {byline && <span class="b">{byline}</span>}
    </div>
  )
}

<style>
  .cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 0.375rem;
    box-shadow: var(--shadow);
  }

  .stand-in {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem;
    text-align: center;
    background: var(--cover);
    color: #f8f4e8;
  }

  .t {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .b {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c1e6ff;
  }
</style>
