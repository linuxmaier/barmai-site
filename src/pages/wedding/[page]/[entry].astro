---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Cover from '../../../components/Cover.astro';
import { entriesFor } from '../../../lib/entries';

// Each entry on a `layout: tiles` page gets a page of its own.
export async function getStaticPaths() {
  const pages = await getCollection(
    'wedding',
    (e) => e.data.layout === 'tiles' && !e.data.draft && !e.data.link,
  );
  const paths = [];
  for (const page of pages) {
    const items = await entriesFor(page.id);
    items.forEach(({ entry, slug }, i) => {
      paths.push({
        params: { page: page.id, entry: slug },
        props: { page, entry, prev: items[i - 1], next: items[i + 1] },
      });
    });
  }
  return paths;
}

const { page, entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const base = `/wedding/${page.id}/`;
---

<Base title={entry.data.title} description={entry.data.byline}>
  <a class="back" href={base}>← {page.data.title}</a>

  <Cover
    class="hero"
    title={entry.data.title}
    byline={entry.data.byline}
    image={entry.data.image}
    alt={entry.data.image_alt}
    sizes="14rem"
  />

  {entry.data.label && <p class="label">{entry.data.label}</p>}
  <h1>{entry.data.title}</h1>
  {entry.data.byline && <p class="byline">{entry.data.byline}</p>}
  <div class="prose"><Content /></div>

  <nav class="pager" aria-label="More from this page">
    {
      prev ? (
        <a href={`${base}${prev.slug}/`}>
          <span>← Previous</span>
          {prev.entry.data.title}
        </a>
      ) : (
        <span />
      )
    }
    {
      next && (
        <a class="next" href={`${base}${next.slug}/`}>
          <span>Next →</span>
          {next.entry.data.title}
        </a>
      )
    }
  </nav>
</Base>

<style>
  :global(.hero) {
    max-width: 14rem;
    margin: 0 auto 2rem;
  }

  .label {
    margin: 0 0 0.25rem;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 0.25rem;
  }

  .byline {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-style: italic;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: grid;
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.25;
    text-decoration: none;
  }

  .pager a span {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .pager .next {
    text-align: right;
  }
</style>
