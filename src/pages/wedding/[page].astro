---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Cover from '../../components/Cover.astro';
import { entriesFor } from '../../lib/entries';

// A page for every entry that isn't the landing page or a link to another site.
export async function getStaticPaths() {
  const pages = await getCollection(
    'wedding',
    (e) => e.id !== 'index' && !e.data.draft && !e.data.link,
  );
  return pages.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// The page's entries come from the folder with the same name: content/wedding/<page>/*.md.
// Tiles link to each entry's own page ([page]/[entry].astro); sections show them all here.
const tiles = entry.data.layout === 'tiles';
const items = await Promise.all(
  (await entriesFor(entry.id)).map(async ({ entry: e, slug }) => ({
    anchor: slug,
    data: e.data,
    Body: tiles ? null : (await render(e)).Content,
  })),
);
const mentions = (await entriesFor(entry.id, { mentions: true })).map(({ entry: e }) => e.data);
---

<Base title={entry.data.title} description={entry.data.description}>
  <a class="back" href="/wedding/">← All wedding info</a>
  <h1>{entry.data.title}</h1>
  <div class="prose"><Content /></div>

  {
    tiles && (
      <ul class="tiles">
        {items.map(({ anchor, data }) => (
          <li>
            <a class="tile" href={`/wedding/${entry.id}/${anchor}/`}>
              <Cover
                title={data.title}
                byline={data.byline}
                image={data.image}
                alt={data.image_alt}
                sizes="(max-width: 36rem) 45vw, 11rem"
              />
              {data.label && <span class="tile-label">{data.label}</span>}
              <span class="tile-title">{data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    !tiles && items.length >= 3 && (
      <nav class="contents" aria-label="On this page">
        <ul>
          {items.map((i) => (
            <li>
              <a href={`#${i.anchor}`}>{i.data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }

  {
    !tiles &&
      items.map(({ anchor, data, Body }) => (
      <section class="entry" id={anchor}>
        {data.image && (
          <Image
            class="entry-image"
            src={data.image}
            alt={data.image_alt ?? ''}
            widths={[160, 320]}
            sizes="8rem"
          />
        )}
        <h2>{data.title}</h2>
        {data.byline && <p class="byline">{data.byline}</p>}
        <div class="prose">{Body && <Body />}</div>
      </section>
    ))
  }

  {
    mentions.length > 0 && (
      <section class="mentions">
        <h2>Honorable mentions</h2>
        <ul>
          {mentions.map((m) => (
            <li>
              <cite>{m.title}</cite>
              {m.byline && <span class="mention-byline"> by {m.byline}</span>}
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .tiles {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
    gap: 1.5rem 1rem;
  }

  .tile {
    display: grid;
    gap: 0.15rem;
    color: var(--ink);
    text-decoration: none;
  }

  .tile :global(.cover) {
    margin-bottom: 0.5rem;
    transition: transform 0.15s;
  }

  .tile:hover :global(.cover) {
    transform: translateY(-2px);
  }

  .tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 0.375rem;
  }

  .tile-label {
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tile-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.2;
  }

  @media (prefers-reduced-motion: reduce) {
    .tile :global(.cover) {
      transition: none;
    }
    .tile:hover :global(.cover) {
      transform: none;
    }
  }

  .contents ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 0.875rem;
    display: grid;
    gap: 0.35rem;
  }

  .entry {
    display: flow-root;
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
    scroll-margin-top: 1rem;
  }

  .entry h2 {
    margin-top: 0;
    margin-bottom: 0.25rem;
  }

  /* No byline: keep the same gap the byline would leave. */
  .entry h2 + .prose {
    margin-top: 1rem;
  }

  /* Headings inside an entry sit below its title. */
  .entry .prose :global(h2) {
    font-size: 1.35rem;
  }

  .byline {
    margin: 0 0 1rem;
    color: var(--muted);
    font-style: italic;
  }

  .mentions {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .mentions h2 {
    margin-top: 0;
  }

  .mentions ul {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.5rem;
  }

  .mentions li {
    font-family: var(--serif);
  }

  .mentions cite {
    font-style: normal;
    font-weight: 700;
  }

  .mention-byline {
    color: var(--muted);
  }

  .entry-image {
    float: right;
    width: 8rem;
    height: auto;
    margin: 0 0 1rem 1.25rem;
    border-radius: 0.375rem;
    box-shadow: var(--shadow);
  }
</style>
